{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Storage": {
    "Provider": "LocalFileSystem",
    "LocalFileSystem": {
      "RootPath": "data/files"
    }
  },
  "Upload": {
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".txt", ".md", ".pdf" ]
  },
  "Ingestion": {
    "Queue": {
      "Provider": "InMemoryChannel"
    },
    "Chunking": {
      "MaxTokens": 500,
      "OverlapTokens": 50
    }
  },
  "Ai": {
    "Provider": "Ollama",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "ChatModel": "lfm3:1.7b",
      "EmbeddingModel": "nomic-embed-text:latest",
      "RequestTimeoutSeconds": 120,
      "HealthCheckTimeoutSeconds": 5
    }
  },
  "Retrieval": {
    "VectorStore": {
      "Provider": "Sqlite"
    },
    "KeywordIndex": {
      "Provider": "SqliteFts5"
    },
    "DefaultTopK": 8,
    "MaxTopK": 50,
    "UseKeywordSearch": true,
    "RrfK": 60,
    "CandidateMultiplier": 2
  },
  "Chat": {
    "RetrievalTopK": 6,
    "MaxHistoryMessages": 10,
    "MaxHistoryTokens": 2000,
    "MaxContextTokens": 4000,
    "MaxMessageLength": 16000,
    "Temperature": 0.2
  },
  "ConnectionStrings": {
    "Lexicon": "Data Source=data/lexicon.db"
  },
  "AllowedHosts": "*"
}
