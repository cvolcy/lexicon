{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Storage": {
    "Provider": "LocalFileSystem",
    "LocalFileSystem": {
      "RootPath": "data/files"
    }
  },
  "Upload": {
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".txt", ".md", ".pdf" ]
  },
  "Ingestion": {
    "Queue": {
      "Provider": "InMemoryChannel"
    },
    "Chunking": {
      "MaxTokens": 500,
      "OverlapTokens": 50
    }
  },
  "ConnectionStrings": {
    "Lexicon": "Data Source=data/lexicon.db"
  },
  "AllowedHosts": "*"
}
